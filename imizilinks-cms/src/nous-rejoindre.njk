{% from "macros.njk" import phero, faqBloc %}
{{ phero("Nous rejoindre", "Rejoindre la communauté ImiziLinks",
   "Devenir référent dans ta ville, écrire un guide, relire des CV ou simplement poser une question : dis-nous ce que tu veux faire, on te recontacte sous 48 heures.",
   "/img/etudiants-campus-universite.jpg", "Étudiants échangeant devant leur université en France") }}

  <section class="sec">
    <div class="wrap">
      <div class="form-solo reveal" id="form">
        <form class="form-card" id="formRejoindre" name="nous-rejoindre" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" enctype="multipart/form-data" action="/merci/">
          <input type="hidden" name="form-name" value="nous-rejoindre">
          <p class="hp-field" hidden><label>Ne rien remplir <input name="bot-field"></label></p>

          <h2 class="form-h2">Écris-nous</h2>
          <p class="fc-sub">Réponse sous 48 heures ouvrées. Aucune inscription préalable, aucun frais.</p>

          <div class="fg-row">
            <div class="fg"><label for="r-prenom">Prénom <span class="required-star" aria-hidden="true">*</span></label><input id="r-prenom" name="prenom" type="text" placeholder="Marie" required></div>
            <div class="fg"><label for="r-nom">Nom <span class="required-star" aria-hidden="true">*</span></label><input id="r-nom" name="nom" type="text" placeholder="Niyonzima" required></div>
          </div>
          <div class="fg-row">
            <div class="fg"><label for="r-mail">Email <span class="required-star" aria-hidden="true">*</span></label><input id="r-mail" name="email" type="email" placeholder="marie@email.com" required></div>
            <div class="fg"><label for="r-tel">Téléphone <span class="required-star" aria-hidden="true">*</span></label><input id="r-tel" name="telephone" type="tel" placeholder="06 12 34 56 78" required></div>
          </div>
          <div class="fg"><label for="r-ville">Ville <span class="opt">(facultatif)</span></label><input id="r-ville" name="ville" type="text" placeholder="Lyon"></div>

          <div class="fg"><label for="r-role">Ce que tu souhaites faire <span class="opt">(facultatif)</span></label>
            <select id="r-role" name="role">
              <option value="">Choisir</option>
              <option value="Devenir référent dans ma ville">Devenir référent dans ma ville</option>
              <option value="Écrire un article ou un guide">Écrire un article ou un guide</option>
              <option value="Relire des CV ou animer un atelier">Relire des CV ou animer un atelier</option>
              <option value="Demander une relecture de mon CV">Demander une relecture de mon CV</option>
              <option value="Organiser un événement dans ma ville">Organiser un événement dans ma ville</option>
              <option value="Relayer une offre d'emploi de mon entreprise">Relayer une offre d'emploi de mon entreprise</option>
              <option value="Poser une question générale">Poser une question générale</option>
            </select>
          </div>

          <div class="fg" id="bloc-cv"><label for="r-cv">CV <span class="opt">(facultatif)</span></label>
            <div class="depot">
              <p class="depot-h">Joins ton CV si tu veux une relecture</p>
              <input id="r-cv" name="cv" type="file" accept=".pdf,.doc,.docx,.jpg,.png">
              <p class="depot-d">Formats acceptés : PDF, Word, JPG ou PNG. 5 Mo maximum.</p>
            </div>
          </div>

          <div class="fg"><label for="r-msg">Ton message <span class="opt">(facultatif)</span></label><textarea id="r-msg" name="message" placeholder="Dis-nous en quelques lignes ce que tu aimerais faire ou sur quoi tu peux aider."></textarea></div>

          <button type="submit" class="btn btn-primary btn-full">Envoyer</button>
          <p class="form-note">Tes informations ne sont partagées qu'avec la personne chargée de traiter ta demande.</p>
        </form>
      </div>

      <div class="contact-strip reveal">
        <div class="cs-box"><p class="cs-l">Email</p><p class="cs-v"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p><p class="cs-d">Réponse sous 48 heures</p></div>
        <div class="cs-box"><p class="cs-l">Autres demandes</p><p class="cs-v"><a href="/entraide/#form">Entraide</a> · <a href="/evenements/#form">Événements</a> · <a href="/opportunites/">Opportunités</a></p><p class="cs-d">Chaque besoin a son formulaire dédié</p></div>
        <div class="cs-box"><p class="cs-l">Rejoignez notre communauté</p>
          <div class="cs-socials">
            <a href="{{ site.linkedin or '#linkedin-a-completer' }}" class="cs-soc" aria-label="LinkedIn ImiziLinks" rel="noopener" target="_blank">
              <img src="/img/icon-linkedin.svg" alt="LinkedIn" width="40" height="40" loading="lazy">
            </a>
            <a href="{{ site.instagram or '#instagram-a-completer' }}" class="cs-soc" aria-label="Instagram ImiziLinks" rel="noopener" target="_blank">
              <img src="/img/icon-instagram.svg" alt="Instagram" width="40" height="40" loading="lazy">
            </a>
          </div>
          <p class="cs-d">Actualités et témoignages</p>
        </div>
      </div>
    </div>
  </section>

{{ faqBloc("Nous rejoindre :<br><span class='grad'>les questions fréquentes.</span>", "Fonctionnement des formulaires, protection des données, contribution et partenariats.", faq.rejoindre) }}
