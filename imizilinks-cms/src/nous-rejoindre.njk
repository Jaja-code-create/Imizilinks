{% from "macros.njk" import phero, faqBloc %}
{{ phero("Nous rejoindre", "Rejoindre la communauté ImiziLinks",
   "Devenir référent dans ta ville, écrire un guide, relire des CV ou simplement poser une question : dis-nous ce que tu veux faire, on te recontacte sous 48 heures.",
   "/img/etudiants-campus-universite.jpg", "Étudiants échangeant devant leur université en France") }}

  <section class="sec">
    <div class="wrap">
      <div class="form-solo reveal" id="form">
        <form class="form-card" id="formRejoindre" name="nous-rejoindre" method="POST"
              data-netlify="true" data-netlify-honeypot="bot-field" action="/merci/">
          <input type="hidden" name="form-name" value="nous-rejoindre">
          <p class="hp-field" hidden><label>Ne rien remplir <input name="bot-field"></label></p>

          <h2 class="form-h2">Écris-nous</h2>
          <p class="fc-sub">Réponse sous 48 heures ouvrées. Aucune inscription préalable, aucun frais.</p>

          <div class="fg-row">
            <div class="fg"><label for="r-prenom">Prénom</label><input id="r-prenom" name="prenom" type="text" placeholder="Marie" required></div>
            <div class="fg"><label for="r-nom">Nom</label><input id="r-nom" name="nom" type="text" placeholder="Niyonzima" required></div>
          </div>
          <div class="fg-row">
            <div class="fg"><label for="r-mail">Email</label><input id="r-mail" name="email" type="email" placeholder="marie@email.com" required></div>
            <div class="fg"><label for="r-tel">Téléphone <span class="opt">(facultatif)</span></label><input id="r-tel" name="telephone" type="tel" placeholder="06 12 34 56 78"></div>
          </div>
          <div class="fg"><label for="r-ville">Ville</label><input id="r-ville" name="ville" type="text" placeholder="Lyon" required></div>

          <div class="fg"><label for="r-role">Ce que tu souhaites faire</label>
            <select id="r-role" name="role" required>
              <option value="">Choisir</option>
              <option value="Devenir référent dans ma ville">Devenir référent dans ma ville</option>
              <option value="Écrire un article ou un guide">Écrire un article ou un guide</option>
              <option value="Relire des CV ou animer un atelier">Relire des CV ou animer un atelier</option>
              <option value="Organiser un événement dans ma ville">Organiser un événement dans ma ville</option>
              <option value="Relayer une offre d'emploi de mon entreprise">Relayer une offre d'emploi de mon entreprise</option>
              <option value="Poser une question générale">Poser une question générale</option>
            </select>
          </div>

          <div class="fg"><label for="r-msg">Ton message</label><textarea id="r-msg" name="message" placeholder="Dis-nous en quelques lignes ce que tu aimerais faire ou sur quoi tu peux aider." required></textarea></div>

          <button type="submit" class="btn btn-primary btn-full">Envoyer</button>
          <p class="form-note">Tes informations ne sont partagées qu'avec la personne chargée de traiter ta demande.</p>
        </form>
      </div>

      <div class="contact-strip reveal">
        <div class="cs-box"><p class="cs-l">Email</p><p class="cs-v"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p><p class="cs-d">Réponse sous 48 heures</p></div>
        <div class="cs-box"><p class="cs-l">Autres demandes</p><p class="cs-v"><a href="/entraide/#form">Entraide</a> · <a href="/evenements/#form">Événements</a> · <a href="/opportunites/">Opportunités</a></p><p class="cs-d">Chaque besoin a son formulaire dédié</p></div>
        <div class="cs-box"><p class="cs-l">Réseaux</p>
          <div class="cs-socials">
            <a href="{{ site.linkedin or '#linkedin-a-completer' }}" class="cs-soc" aria-label="LinkedIn ImiziLinks" rel="noopener" target="_blank">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"/></svg>
            </a>
            <a href="{{ site.instagram or '#instagram-a-completer' }}" class="cs-soc" aria-label="Instagram ImiziLinks" rel="noopener" target="_blank">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.12 1.38A5.87 5.87 0 0 0 .63 4.14c-.3.76-.5 1.64-.56 2.9C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.12.66.66 1.33 1.08 2.12 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.87 5.87 0 0 0 2.12-1.38 5.87 5.87 0 0 0 1.38-2.12c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.87 5.87 0 0 0-1.38-2.12A5.87 5.87 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32A6.16 6.16 0 0 0 12 5.84ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm7.85-10.41a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0Z"/></svg>
            </a>
          </div>
          <p class="cs-d">Actualités et témoignages</p>
        </div>
      </div>
    </div>
  </section>

