{% from "macros.njk" import phero, faqBloc %}
{{ phero("Nous rejoindre", "S'impliquer dans ImiziLinks",
   "Ce formulaire est réservé à celles et ceux qui veulent contribuer : devenir référent, écrire un guide, organiser un événement local ou proposer un partenariat. Pour une demande d'aide, rends-toi sur la page Entraide ; pour t'inscrire à un événement, sur la page Événements.",
   "/img/etudiants-campus-universite.jpg", "Étudiants échangeant devant leur université en France") }}

  <section class="sec">
    <div class="wrap">
      <div class="redir-row reveal">
        <a href="/entraide/#form-entraide" class="redir-card">
          <span class="redir-t">Besoin d'aide pour une démarche ?</span>
          <span class="redir-d">Attestation d'hébergement, CAF, préfecture, logement → formulaire d'entraide</span>
        </a>
        <a href="/evenements/#form-evenement" class="redir-card">
          <span class="redir-t">T'inscrire à un événement ?</span>
          <span class="redir-d">Forums, webinaires, ateliers → formulaire d'inscription</span>
        </a>
        <a href="/opportunites/" class="redir-card">
          <span class="redir-t">Postuler à une offre ?</span>
          <span class="redir-d">Emploi, stage, alternance → dépôt de candidature</span>
        </a>
      </div>

      <div class="form-solo reveal">
        <form class="form-card" id="formContact" name="contribuer" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/merci/?type=contribuer">
          <input type="hidden" name="form-name" value="contribuer">
          <p class="hp" aria-hidden="true"><label>Ne rien remplir <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
          <h2 class="form-h2">Proposer ta contribution</h2>
          <p class="fc-sub">Réponse sous 48 heures ouvrées. Choisis ton rôle, les champs s'adaptent.</p>

          <div class="fg"><label for="f-motif">Je souhaite</label>
            <select id="f-motif" name="motif" required>
              <option value="">Choisir un rôle</option>
              <option value="referent">Devenir référent dans ma ville</option>
              <option value="article">Écrire un article ou un guide</option>
              <option value="organiser">Organiser un événement dans ma ville</option>
              <option value="benevolat">Aider ponctuellement (relecture de CV, atelier…)</option>
              <option value="partenariat">Proposer un partenariat (association ou entreprise)</option>
              <option value="autre">Poser une autre question</option>
            </select>
          </div>

          <div class="fg-row">
            <div class="fg"><label for="f-prenom">Prénom</label><input id="f-prenom" name="prenom" type="text" placeholder="Marie" required></div>
            <div class="fg"><label for="f-nom">Nom</label><input id="f-nom" name="nom" type="text" placeholder="Niyonzima" required></div>
          </div>
          <div class="fg-row">
            <div class="fg"><label for="f-mail">Email</label><input id="f-mail" name="email" type="email" placeholder="marie@email.com" required></div>
            <div class="fg"><label for="f-tel">Téléphone <span class="opt">(facultatif)</span></label><input id="f-tel" name="telephone" type="tel" placeholder="06 12 34 56 78"></div>
          </div>

          <div class="cond fg" id="bloc-villeres"><label for="f-villeres">Ta ville</label><input id="f-villeres" name="ville" type="text" placeholder="Lyon"></div>

          <div class="cond fg" id="bloc-structure"><label for="f-structure">Nom de ta structure</label><input id="f-structure" name="structure" type="text" placeholder="Association, entreprise…"></div>

          <div class="fg"><label for="f-msg" id="lbl-msg">Ton message</label><textarea id="f-msg" name="message" placeholder="Présente-toi en quelques lignes et dis-nous ce que tu as en tête." required></textarea></div>

          <button type="submit" class="btn btn-primary btn-full">Envoyer</button>
          <p class="form-note">Tes informations ne sont partagées qu'avec la personne chargée de traiter ta demande.</p>
        </form>
      </div>

      <div class="contact-strip reveal">
        <div class="cs-box"><p class="cs-l">Email</p><p class="cs-v"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p><p class="cs-d">Réponse sous 48 heures</p></div>
        <div class="cs-box"><p class="cs-l">Réseaux</p><p class="cs-v"><a href="{{ site.instagram or '#' }}" rel="noopener">Instagram</a> · <a href="{{ site.linkedin or '#' }}" rel="noopener">LinkedIn</a></p><p class="cs-d">Actualités et témoignages</p></div>
      </div>
    </div>
  </section>

{{ faqBloc("Nous rejoindre :<br><span class='grad'>les questions fréquentes.</span>", "Devenir référent, contribuer un guide, organiser un événement, protection des données et partenariats.", faq.rejoindre) }}
