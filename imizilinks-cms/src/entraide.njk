{% from "macros.njk" import phero, faqBloc, cta %}
{{ phero("Nos actions · Entraide", "Informations et accompagnement pour s’installer en France",
   "Titre de séjour, sécurité sociale, attestation d’hébergement, compte bancaire : nous vous donnons les informations utiles pour avancer, et un référent bénévole de votre ville peut vous accompagner si vous en avez besoin. Nos référents sont passés par les mêmes étapes que vous. Service gratuit et confidentiel.",
   "/img/etudiants-bibliotheque.jpg", "Étudiants de la diaspora travaillant ensemble en bibliothèque") }}

  <section class="split">
    <div class="split-media reveal"><img src="/img/etudiants-bibliotheque.jpg" alt="Membres d’Imizi Links s’informant sur leurs démarches d’installation" loading="lazy" width="800" height="533"></div>
    <div class="split-txt reveal">
      <p class="slabel">Ce que couvre l’entraide</p>
      <h2>Des besoins concrets,<br><span class="grad">traités un par un.</span></h2>
      <p>L’entraide Imizi Links intervient quand une information fiable ou un contact local vous aide à avancer. Nos référents connaissent les procédures françaises pour les avoir traversées eux-mêmes, et vous orientent si besoin.</p>
      <ul class="checklist">
        <li>Informations sur l’attestation d’hébergement et les justificatifs demandés</li>
        <li>Informations sur le titre de séjour, la sécurité sociale et le compte bancaire</li>
        <li>Mise en relation avec un référent de votre ville</li>
        <li>Orientation sur les études et l’équivalence de diplômes</li>
        <li>Relecture de votre dossier avant dépôt</li>
      </ul>
      <p class="split-cta"><a href="#form" class="btn btn-primary">Faire votre demande</a></p>
    </div>
  </section>

  <section class="sec light">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Comment ça marche</p>
        <h2>Trois étapes,<br><span class="grad">rien de plus.</span></h2>
        <p>Aucune inscription préalable, aucun dossier à constituer, aucun frais.</p>
      </div>
      <div class="proc reveal">
        <div class="proc-etape"><div class="proc-n">1</div><h3 class="proc-t">Vous décrivez votre besoin</h3><p class="proc-d">Le formulaire prend deux minutes : votre ville d’arrivée, vos dates et quelques lignes sur votre situation. Vous pouvez écrire en français, en anglais, en kirundi, en kinyarwanda ou en swahili.</p></div>
        <div class="proc-etape"><div class="proc-n">2</div><h3 class="proc-t">Un référent prend le relais</h3><p class="proc-d">Votre demande est transmise au référent de la ville concernée, une personne installée depuis plusieurs années qui connaît les interlocuteurs locaux.</p></div>
        <div class="proc-etape"><div class="proc-n">3</div><h3 class="proc-t">Vous obtenez une réponse</h3><p class="proc-d">Sous 48 heures ouvrées, par email ou par téléphone. Si nous ne pouvons pas vous aider directement, nous vous orientons vers la structure compétente.</p></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Nos référents</p>
        <h2>Des relais bénévoles<br><span class="grad">dans plusieurs villes.</span></h2>
        <p>Les référents sont des membres installés en France depuis plusieurs années, qui acceptent d’être joignables pour les nouveaux arrivants de leur secteur.</p>
      </div>
      <div class="villes reveal">
        {% for v in villes %}
        <div class="ville"><h3 class="ville-n">{{ v.nom }}</h3><p class="ville-d">{{ v.detail }}</p></div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="sec light">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Pour aller plus loin</p>
        <h2>Les guides liés<br><span class="grad">à ces démarches.</span></h2>
      </div>
      <div class="art-liens reveal" style="max-width:760px;">
        {% for a in collections.articles %}{% if loop.index <= 3 %}
        <a href="{{ a.url }}" class="art-lien"><span class="art-lien-t">{{ a.data.title }}</span><span class="art-lien-c">{{ a.data.categorie }}</span></a>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

  <section class="sec light">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Faire votre demande</p>
        <h2>Décrivez votre situation,<br><span class="grad">un référent vous répond.</span></h2>
        <p>Le formulaire prend deux minutes. Réponse sous 48 heures ouvrées, par email ou par téléphone. Service gratuit et confidentiel.</p>
      </div>
      <div class="form-solo reveal" id="form">
        <form class="form-card" id="formEntraide" name="entraide" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action="/merci/">
          <input type="hidden" name="form-name" value="entraide">
          <p class="hp-field" hidden><label>Ne rien remplir <input name="bot-field"></label></p>

          <div class="fg-row">
            <div class="fg"><label for="e-prenom">Prénom <span class="required-star" aria-hidden="true">*</span></label><input id="e-prenom" name="prenom" type="text" placeholder="Marie" required></div>
            <div class="fg"><label for="e-nom">Nom <span class="required-star" aria-hidden="true">*</span></label><input id="e-nom" name="nom" type="text" placeholder="Niyonzima" required></div>
          </div>
          <div class="fg-row">
            <div class="fg"><label for="e-mail">Email <span class="required-star" aria-hidden="true">*</span></label><input id="e-mail" name="email" type="email" placeholder="marie@email.com" required></div>
            <div class="fg"><label for="e-tel">Téléphone <span class="required-star" aria-hidden="true">*</span></label><input id="e-tel" name="telephone" type="tel" placeholder="06 12 34 56 78" required></div>
          </div>
          <div class="fg"><label for="e-besoin">Type de besoin <span class="required-star" aria-hidden="true">*</span></label>
            <select id="e-besoin" name="besoin" required>
              <option value="">Choisir un besoin</option>
              <option>Information sur une démarche</option>
              <option>Attestation d’hébergement (information)</option>
              <option>Orientation études</option>
              <option>Mise en relation avec un référent</option>
              <option>Autre</option>
            </select>
          </div>
          <div class="fg-row">
            <div class="fg"><label for="e-ville">Ville d’arrivée <span class="opt">(facultatif)</span></label>
              <select id="e-ville" name="ville_arrivee">
                <option value="">Choisir une ville</option>
                {% for v in villes %}<option>{{ v.nom }}</option>{% endfor %}
              </select>
            </div>
            <div class="fg"><label for="e-date">Date d’arrivée <span class="opt">(facultatif)</span></label><input id="e-date" name="date_arrivee" type="date"></div>
          </div>
          <div class="fg"><label for="e-msg">Décrivez votre situation <span class="opt">(facultatif)</span></label><textarea id="e-msg" name="message" placeholder="Quelques lignes sur votre situation et ce dont vous avez besoin. Nous vous recontactons pour les détails."></textarea></div>

          <button type="submit" class="btn btn-primary btn-full">Envoyer ma demande</button>
          <p class="form-note">Votre demande n’est transmise qu’au référent chargé de la traiter. Aucune information n’est publiée ni partagée avec un tiers.</p>
        </form>
      </div>
    </div>
  </section>

{{ faqBloc("L’entraide Imizi Links<br><span class='grad'>en questions.</span>", "Attestation d’hébergement, référents, démarches d’arrivée : les réponses aux questions les plus posées.", faq.entraide) }}
{{ cta("Besoin d’un coup de main ?", "Le formulaire prend deux minutes. Un référent vous répond sous 48 heures.", "Faire votre demande", "/entraide/#form") }}
