{% from "macros.njk" import phero, faqBloc, cta %}
{{ phero("What we do · Support", "Information and support for settling in France",
   "Residence permit, social security, proof of accommodation, bank account. We give you the information you need to move forward, and a volunteer local contact in your city can support you if you need it. Our local contacts have been through the same steps as you. Free and confidential.",
   image, imageAlt) }}

  <section class="split">
    <div class="split-media reveal"><img src="/img/entraide-etudiantes-recherche-logement-telephone.jpg" alt="An Imizi Links member sharing information on her phone" loading="lazy" width="800" height="533"></div>
    <div class="split-txt reveal">
      <p class="slabel">What our support covers</p>
      <h2>Real needs,<br><span class="grad">handled one by one.</span></h2>
      <p>Imizi Links steps in when reliable information or a local contact can help you move forward. Our local contacts know French procedures because they have been through them, and they point you in the right direction when needed.</p>
      <ul class="checklist">
        <li>Information on the proof of accommodation and the supporting documents required</li>
        <li>Information on residence permits, social security and bank accounts</li>
        <li>An introduction to a local contact in your city</li>
        <li>Guidance on studies and the recognition of qualifications</li>
        <li>A review of your application before you submit it</li>
      </ul>
      <p class="split-cta"><a href="#form" class="btn btn-primary">Send your request</a></p>
    </div>
  </section>

  <section class="sec light">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">How it works</p>
        <h2>Three steps,<br><span class="grad">nothing more.</span></h2>
        <p>No registration, no forms to fill in beforehand, no fees.</p>
      </div>
      <div class="proc reveal">
        <div class="proc-etape"><div class="proc-n">1</div><h3 class="proc-t">You describe what you need</h3><p class="proc-d">The form takes two minutes. Tell us your arrival city, your dates and a few lines about your situation. You can write in French, English, Kirundi, Kinyarwanda or Swahili.</p></div>
        <div class="proc-etape"><div class="proc-n">2</div><h3 class="proc-t">A local contact takes over</h3><p class="proc-d">Your request goes to the local contact for your city, someone who has lived there for several years and knows the local organisations.</p></div>
        <div class="proc-etape"><div class="proc-n">3</div><h3 class="proc-t">You get an answer</h3><p class="proc-d">Within 48 working hours, by email or by phone. If we cannot help you directly, we point you to the right organisation.</p></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Our local contacts</p>
        <h2>Volunteers<br><span class="grad">in several cities.</span></h2>
        <p>Our local contacts are members who have lived in France for several years and agree to be available to newcomers in their area.</p>
      </div>
      <div class="villes reveal">
        {% for v in villesEn %}
        <div class="ville"><h3 class="ville-n">{{ v.nom }}</h3><p class="ville-d">{{ v.detail }}</p></div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="sec light">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Find out more</p>
        <h2>Guides related<br><span class="grad">to these steps.</span></h2>
      </div>
      <div class="art-liens reveal" style="max-width:760px;">
        {% for a in collections.articlesEn %}{% if loop.index <= 3 %}
        <a href="{{ a.url }}" class="art-lien"><span class="art-lien-t">{{ a.data.title }}</span><span class="art-lien-c">{{ a.data.categorie }}</span></a>
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>

  <section class="sec light">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Send your request</p>
        <h2>Describe your situation,<br><span class="grad">a local contact will reply.</span></h2>
        <p>The form takes two minutes. You will get a reply within 48 working hours, by email or by phone. Free and confidential.</p>
      </div>
      <div class="form-solo reveal" id="form">
        <form class="form-card" id="formSupport" name="support-en" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action="/en/thank-you/">
          <input type="hidden" name="form-name" value="support-en">
          <p class="hp-field" hidden><label>Do not fill this in <input name="bot-field"></label></p>

          <div class="fg-row">
            <div class="fg"><label for="e-prenom">First name <span class="required-star" aria-hidden="true">*</span></label><input id="e-prenom" name="first_name" type="text" placeholder="Marie" required></div>
            <div class="fg"><label for="e-nom">Last name <span class="required-star" aria-hidden="true">*</span></label><input id="e-nom" name="last_name" type="text" placeholder="Niyonzima" required></div>
          </div>
          <div class="fg-row">
            <div class="fg"><label for="e-mail">Email <span class="required-star" aria-hidden="true">*</span></label><input id="e-mail" name="email" type="email" placeholder="marie@email.com" required></div>
            <div class="fg"><label for="e-tel">Phone <span class="required-star" aria-hidden="true">*</span></label><input id="e-tel" name="phone" type="tel" placeholder="06 12 34 56 78" required></div>
          </div>
          <div class="fg"><label for="e-besoin">What do you need? <span class="required-star" aria-hidden="true">*</span></label>
            <select id="e-besoin" name="need" required>
              <option value="">Choose an option</option>
              <option>Information about a procedure</option>
              <option>Proof of accommodation (information)</option>
              <option>Guidance on studies</option>
              <option>Introduction to a local contact</option>
              <option>Other</option>
            </select>
          </div>
          <div class="fg-row">
            <div class="fg"><label for="e-ville">Arrival city <span class="opt">(optional)</span></label>
              <select id="e-ville" name="arrival_city">
                <option value="">Choose a city</option>
                {% for v in villesEn %}<option>{{ v.nom }}</option>{% endfor %}
              </select>
            </div>
            <div class="fg"><label for="e-date">Arrival date <span class="opt">(optional)</span></label><input id="e-date" name="arrival_date" type="date"></div>
          </div>
          <div class="fg"><label for="e-msg">Describe your situation <span class="opt">(optional)</span></label><textarea id="e-msg" name="message" placeholder="A few lines about your situation and what you need. We will get back to you for the details."></textarea></div>

          <button type="submit" class="btn btn-primary btn-full">Send my request</button>
          <p class="form-note">Your request is only shared with the local contact who handles it. No information is published or shared with anyone else.</p>
        </form>
      </div>
    </div>
  </section>

{{ faqBloc("Imizi Links support<br><span class='grad'>in questions.</span>", "Answers to the most common questions about the proof of accommodation, our local contacts and the first steps after arriving.", faqEn.entraide, "Frequently asked questions") }}
{{ cta("Need a hand?", "The form takes two minutes. A local contact will reply within 48 hours.", "Send your request", "/en/support/#form") }}
