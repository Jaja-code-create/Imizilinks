            <option value="Relay offers">Relay offers</option>
            <option value="Mobilise my teams">Mobilise my teams</option>
            <option value="Environmental contribution">Environmental contribution</option>
            <option value="Other request">Other request</option>
          </select>
        </div>
        <div class="field-row">
          <div class="field"><label for="p-prenom">First name <span class="req" aria-hidden="true">*</span></label><input id="p-prenom" name="first_name" type="text" required placeholder="Marie"></div>
          <div class="field"><label for="p-nom">Last name <span class="req" aria-hidden="true">*</span></label><input id="p-nom" name="last_name" type="text" required placeholder="Niyonzima"></div>
        </div>
        <div class="field"><label for="p-entreprise">Company or organisation <span class="req" aria-hidden="true">*</span></label><input id="p-entreprise" name="company" type="text" required placeholder="Your organisation's name"></div>
        <div class="field-row">
          <div class="field"><label for="p-mail">Work email <span class="req" aria-hidden="true">*</span></label><input id="p-mail" name="email" type="email" required placeholder="marie@company.com"></div>
          <div class="field"><label for="p-tel">Phone <span class="req" aria-hidden="true">*</span></label><input id="p-tel" name="phone" type="tel" required placeholder="06 12 34 56 78"></div>
        </div>
        <div class="field"><label for="p-msg">Your message</label><textarea id="p-msg" name="message" placeholder="Briefly describe your project, your recruitment needs or your CSR goals."></textarea>
