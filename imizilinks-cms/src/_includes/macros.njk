{% macro phero(crumb, h1, chapo, image, alt, court=false) %}
  <header class="phero{% if court %} phero-court{% endif %}">
    <div class="phero-bg" style="background-image:url('{{ image }}')" role="img" aria-label="{{ alt }}"></div>
    <div class="phero-ov"></div>
    <div class="phero-in">
      <p class="phero-crumb">{{ crumb }}</p>
      <h1>{{ h1 }}</h1>
      {% if chapo %}<p>{{ chapo }}</p>{% endif %}
    </div>
  </header>
{% endmacro %}

{% macro faqBloc(titre, intro, items) %}
{% if items and items.length %}
  <section class="faq-sec">
    <div class="faq-wrap">
      <div class="sec-head center reveal">
        <p class="slabel">Questions fréquentes</p>
        <h2>{{ titre | safe }}</h2>
        {% if intro %}<p>{{ intro }}</p>{% endif %}
      </div>
      <div class="faq-list reveal">
        {% for f in items %}
        <div class="faq-item">
          <h3><button class="faq-q">{{ f.question }}</button></h3>
          <div class="faq-a"><p>{{ f.reponse }}</p></div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}
{% endmacro %}

{% macro cta(titre, texte, label, lien) %}
  <section class="cta-band">
    <h2>{{ titre | safe }}</h2>
    <p>{{ texte }}</p>
    <a href="{{ lien }}" class="btn btn-light">{{ label }}</a>
  </section>
{% endmacro %}

{# ─── Formulaire d'entraide (page /entraide/) ─── #}
{% macro formEntraide(villes) %}
  <div class="form-solo reveal" id="form-entraide">
    <form class="form-card" name="entraide" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/merci/?type=entraide">
      <input type="hidden" name="form-name" value="entraide">
      <p class="hp" aria-hidden="true"><label>Ne rien remplir <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
      <h2 class="form-h2">Décris ta situation</h2>
      <p class="fc-sub">Réponse d'un référent de ta ville sous 48 heures ouvrées. Service gratuit et confidentiel, aucune inscription préalable.</p>

      <div class="fg-row">
        <div class="fg"><label for="e-prenom">Prénom</label><input id="e-prenom" name="prenom" type="text" placeholder="Marie" required></div>
        <div class="fg"><label for="e-nom">Nom</label><input id="e-nom" name="nom" type="text" placeholder="Niyonzima" required></div>
      </div>
      <div class="fg-row">
        <div class="fg"><label for="e-mail">Email</label><input id="e-mail" name="email" type="email" placeholder="marie@email.com" required></div>
        <div class="fg"><label for="e-tel">Téléphone <span class="opt">(facultatif)</span></label><input id="e-tel" name="telephone" type="tel" placeholder="06 12 34 56 78"></div>
      </div>
      <div class="fg-row">
        <div class="fg"><label for="e-ville">Ville d'arrivée</label>
          <select id="e-ville" name="ville_arrivee" required>
            <option value="">Choisir une ville</option>
            {% for v in villes %}{% if '?' not in v.nom %}<option>{{ v.nom }}</option>{% endif %}{% endfor %}
            <option>Autre / ville non listée</option>
          </select>
        </div>
        <div class="fg"><label for="e-date">Date d'arrivée <span class="opt">(si connue)</span></label><input id="e-date" name="date_arrivee" type="date"></div>
      </div>
      <div class="fg"><label for="e-besoin">Type de besoin</label>
        <select id="e-besoin" name="besoin" required>
          <option value="">Choisir un besoin</option>
          <option>Attestation d'hébergement</option>
          <option>Démarches administratives (préfecture, titre de séjour)</option>
          <option>CAF et aide au logement</option>
          <option>Sécurité sociale</option>
          <option>Compte bancaire</option>
          <option>Logement temporaire</option>
          <option>Orientation études / équivalence de diplôme</option>
          <option>Relecture de dossier avant dépôt</option>
          <option>Autre</option>
        </select>
      </div>
      <div class="fg"><label for="e-msg">Ta situation en quelques lignes</label><textarea id="e-msg" name="message" placeholder="Décris où tu en es, ce qui bloque et pour quelle échéance. Tu peux écrire en français, anglais, kirundi, kinyarwanda ou swahili." required></textarea></div>

      <button type="submit" class="btn btn-primary btn-full">Envoyer ma demande</button>
      <p class="form-note">Tes informations ne sont transmises qu'au référent chargé de te répondre. Rien n'est publié.</p>
    </form>
  </div>
{% endmacro %}

{# ─── Formulaire d'inscription à un événement (page /evenements/) ─── #}
{% macro formEvenement(evenements) %}
  <div class="form-solo reveal" id="form-evenement">
    <form class="form-card" name="inscription-evenement" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/merci/?type=evenement">
      <input type="hidden" name="form-name" value="inscription-evenement">
      <p class="hp" aria-hidden="true"><label>Ne rien remplir <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
      <h2 class="form-h2">S'inscrire à un événement</h2>
      <p class="fc-sub">Confirmation de ta place par retour de message. Participation libre et gratuite.</p>

      <div class="fg"><label for="v-event">Événement</label>
        <select id="v-event" name="evenement" required>
          <option value="">Choisir un événement</option>
          {% for e in evenements %}<option>{{ e.label }}</option>{% endfor %}
        </select>
      </div>
      <div class="fg-row">
        <div class="fg"><label for="v-prenom">Prénom</label><input id="v-prenom" name="prenom" type="text" placeholder="Marie" required></div>
        <div class="fg"><label for="v-nom">Nom</label><input id="v-nom" name="nom" type="text" placeholder="Niyonzima" required></div>
      </div>
      <div class="fg-row">
        <div class="fg"><label for="v-mail">Email</label><input id="v-mail" name="email" type="email" placeholder="marie@email.com" required></div>
        <div class="fg"><label for="v-tel">Téléphone <span class="opt">(facultatif)</span></label><input id="v-tel" name="telephone" type="tel" placeholder="06 12 34 56 78"></div>
      </div>
      <div class="fg"><label for="v-nb">Nombre de personnes</label>
        <select id="v-nb" name="nombre_personnes">
          <option>1</option><option>2</option><option>3</option><option>4</option><option>5 ou plus</option>
        </select>
      </div>
      <div class="fg"><label for="v-msg">Une question ou une précision ? <span class="opt">(facultatif)</span></label><textarea id="v-msg" name="message" placeholder="Contrainte d'horaire, accessibilité, première participation…"></textarea></div>

      <button type="submit" class="btn btn-primary btn-full">Confirmer mon inscription</button>
      <p class="form-note">Pour les rendez-vous à places limitées, préviens-nous si tu ne peux plus venir : cela libère ta place.</p>
    </form>
  </div>
{% endmacro %}

{% macro carteArticle(a) %}
        <article class="bcard">
          <a href="{{ a.url }}">
            <div class="bimg"><img src="{{ a.data.image }}" alt="{{ a.data.title }}" loading="lazy" width="600" height="400"><span class="btag">{{ a.data.categorie }}</span></div>
            <div class="bbody">
              <h3 class="btitle">{{ a.data.title }}</h3>
              <p class="bexc">{{ a.data.description }}</p>
              <p class="bmeta">{{ a.data.duree }}</p>
            </div>
          </a>
        </article>
{% endmacro %}
