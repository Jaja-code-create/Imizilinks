---
layout: base.njk
actif: blog
pageKey: blog
schemaArticle: true
lang: en
---
{% from "macros.njk" import phero, faqBloc, cta %}
{{ phero("Blog · " + categorie + " · " + duree, title, description, image, title) }}

  <section class="sec">
    <article class="article">
      <p><a href="/en/blog/" class="retour">← All articles</a></p>
      {% if chapeau %}<p class="chapeau">{{ chapeau }}</p>{% endif %}
      {{ content | safe }}
      <div class="art-suite">
        <h2>Read next</h2>
        <div class="art-liens">
          {% for a in collections.articlesEn | autres(page.url, 2) %}
          <a href="{{ a.url }}" class="art-lien"><span class="art-lien-t">{{ a.data.title }}</span><span class="art-lien-c">{{ a.data.categorie }}</span></a>
          {% endfor %}
        </div>
      </div>
    </article>
  </section>

{{ faqBloc(categorie + ":<br><span class='grad'>frequently asked questions.</span>", "Answers to the most common questions on this topic.", faqItems, "Frequently asked questions") }}
{{ cta("A question about this procedure?", "An ImiziLinks local contact can support you and review your file before you submit it.", "Ask for help", "/en/support/#form") }}
