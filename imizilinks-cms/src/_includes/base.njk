<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="author" content="{{ site.nom }}">
<meta property="og:type" content="{% if layout == 'article.njk' %}article{% else %}website{% endif %}">
<meta property="og:locale" content="fr_FR">
<meta property="og:site_name" content="{{ site.nom }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ image or '/img/communaute-diaspora-paris.jpg' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}{{ image or '/img/communaute-diaspora-paris.jpg' }}">
<meta name="theme-color" content="#8C613B">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"Organization","@id":"{{ site.url }}/#organization",
 "name":{{ site.nom | dump | safe }},"url":"{{ site.url }}/",
 "slogan":{{ site.slogan | dump | safe }},
 "description":"Plateforme communautaire gratuite d'entraide, d'emploi et d'événements pour la diaspora d'Afrique de l'Est en France.",
 "areaServed":{"@type":"Country","name":"France"},
 "email":{{ site.email | dump | safe }},
 "knowsLanguage":["fr","en","sw","rn","rw"],
 "contactPoint":[
  {"@type":"ContactPoint","contactType":"customer support","email":{{ site.email | dump | safe }},"availableLanguage":["French","English","Swahili"]}]
}
</script>
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"WebSite","@id":"{{ site.url }}/#website",
 "name":{{ site.nom | dump | safe }},"url":"{{ site.url }}/","inLanguage":"fr-FR",
 "publisher":{"@id":"{{ site.url }}/#organization"}
}
</script>
{% if faqKey and faq[faqKey] %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in faq[faqKey] %}{"@type":"Question","name":{{ f.question | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.reponse | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% elif faqItems %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in faqItems %}{"@type":"Question","name":{{ f.question | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.reponse | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}
{% if fil %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for e in fil %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ e.nom | dump | safe }},"item":"{{ site.url }}{{ e.url }}"}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}
{% if schemaArticle %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"Article",
 "headline":{{ title | dump | safe }},
 "description":{{ description | dump | safe }},
 "image":"{{ site.url }}{{ image }}",
 "inLanguage":"fr-FR",
 "datePublished":"{{ page.date | dateIso }}",
 "dateModified":"{{ page.date | dateIso }}",
 "author":{"@id":"{{ site.url }}/#organization"},
 "publisher":{"@id":"{{ site.url }}/#organization"},
 "mainEntityOfPage":{"@type":"WebPage","@id":"{{ site.url }}{{ page.url }}"},
 "articleSection":{{ categorie | dump | safe }}
}
</script>
{% endif %}
{% if schemaOffres %}
{% for o in offres %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"JobPosting",
 "title":{{ o.titre | dump | safe }},
 "description":{{ o.desc | dump | safe }},
 "datePosted":"{{ o.datePosted or '2026-09-01' }}",
 "employmentType":{{ o.typeContrat | dump | safe if o.typeContrat else '"OTHER"' | safe }},
 "hiringOrganization":{"@type":"Organization","name":{{ o.entreprise | dump | safe }}},
 "jobLocation":{"@type":"Place","address":{"@type":"PostalAddress","addressLocality":{{ o.ville | dump | safe }},"addressCountry":"FR"}},
 "directApply":false,
 "identifier":{"@type":"PropertyValue","name":{{ site.nom | dump | safe }},"value":{{ o.id | dump | safe }}}
}
</script>
{% endfor %}
{% endif %}
{% if schemaEvents %}
{% for e in evenements %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"Event",
 "name":{{ e.nom | dump | safe }},
 "description":{{ e.desc | dump | safe }},
 "startDate":"{{ e.dateIso or '2027-02-14' }}",
 "eventAttendanceMode":"https://schema.org/{% if 'ligne' in e.lieu %}Online{% else %}Offline{% endif %}EventAttendanceMode",
 "eventStatus":"https://schema.org/EventScheduled",
 "location":{% if 'ligne' in e.lieu %}{"@type":"VirtualLocation","url":"{{ site.url }}/evenements/"}{% else %}{"@type":"Place","name":{{ e.lieu | dump | safe }},"address":{"@type":"PostalAddress","addressCountry":"FR"}}{% endif %},
 "organizer":{"@id":"{{ site.url }}/#organization"},
 "isAccessibleForFree":true
}
</script>
{% endfor %}
{% endif %}
</head>
<body>

<a href="#contenu" class="skip">Aller au contenu</a>
<nav id="nav" aria-label="Navigation principale">
  <a href="/" class="logo">Imizi<em>Links</em></a>
  <div class="nav-menu" id="navMenu">
    <div class="nav-item"><a href="/" class="nav-link{% if actif == 'accueil' %} active{% endif %}">Accueil</a></div>
    <div class="nav-item" id="ddItem">
      <button class="nav-link{% if actif == 'actions' %} active{% endif %}" id="ddBtn" aria-haspopup="true" aria-expanded="false">Nos actions <span class="caret"></span></button>
      <div class="dropdown">
        <a href="/entraide/" class="dd-link"><span class="dd-ico">🤝</span><span><span class="dd-t">Entraide</span><span class="dd-d">Attestation d'hébergement, démarches, référents</span></span></a>
        <a href="/opportunites/" class="dd-link"><span class="dd-ico">💼</span><span><span class="dd-t">Opportunités</span><span class="dd-d">Offres d'emploi de nos entreprises partenaires</span></span></a>
        <a href="/evenements/" class="dd-link"><span class="dd-ico">🗓️</span><span><span class="dd-t">Événements</span><span class="dd-d">Forums, webinaires et rencontres</span></span></a>
      </div>
    </div>
    <div class="nav-item"><a href="/blog/" class="nav-link{% if actif == 'blog' %} active{% endif %}">Blog</a></div>
    <a href="/nous-rejoindre/" class="nav-cta">Nous rejoindre</a>
  </div>
  <button class="burger" id="burger" aria-label="Ouvrir le menu"><span></span><span></span><span></span></button>
</nav>

<main id="contenu">
{{ content | safe }}
</main>

<footer>
  <div class="ft">
    <div>
      <div class="f-logo">Imizi<em>Links</em></div>
      <p class="f-desc">{{ site.description_footer }}</p>
      <div class="f-socials">
        <a href="{{ site.linkedin or '#linkedin-a-completer' }}" class="soc" aria-label="LinkedIn" rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
        <a href="{{ site.instagram or '#instagram-a-completer' }}" class="soc" aria-label="Instagram" rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.12 1.38A5.87 5.87 0 0 0 .63 4.14c-.3.76-.5 1.64-.56 2.9C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.12.66.66 1.33 1.08 2.12 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.87 5.87 0 0 0 2.12-1.38 5.87 5.87 0 0 0 1.38-2.12c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.87 5.87 0 0 0-1.38-2.12A5.87 5.87 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32A6.16 6.16 0 0 0 12 5.84ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm7.85-10.41a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0Z"/></svg>
        </a>
        <a href="{{ site.facebook or '#facebook-a-completer' }}" class="soc" aria-label="Facebook" rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.88v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07Z"/></svg>
        </a>
      </div>
    </div>
    <div class="fc"><h2>Nos actions</h2><ul>
      <li><a href="/entraide/">Entraide et démarches</a></li>
      <li><a href="/opportunites/">Offres d'emploi</a></li>
      <li><a href="/evenements/">Événements</a></li>
    </ul></div>
    <div class="fc"><h2>Guides pratiques</h2><ul>
      {% for a in collections.articles | reverse %}{% if loop.index <= 3 %}
      <li><a href="{{ a.url }}">{{ a.data.title }}</a></li>{% endif %}{% endfor %}
      <li><a href="/blog/">Tous les guides</a></li>
    </ul></div>
    <div class="fc"><h2>Contact</h2>
      <ul class="f-coord">
        <li class="f-coord-l">
          <span class="f-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg></span>
          <span class="f-coord-txt"><span class="f-coord-lbl">Email</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></span>
        </li>
        {% if site.telephone %}
        <li class="f-coord-l">
          <span class="f-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.35 1.9.66 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.31 1.85.53 2.81.66A2 2 0 0 1 22 16.92Z"/></svg></span>
          <span class="f-coord-txt"><span class="f-coord-lbl">Téléphone</span><a href="tel:{{ site.telephone | replace(r/\s/g, '') }}">{{ site.telephone }}</a></span>
        </li>
        {% endif %}
        {% if site.adresse %}
        <li class="f-coord-l">
          <span class="f-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></span>
          <span class="f-coord-txt"><span class="f-coord-lbl">Adresse</span><span class="f-coord-val">{{ site.adresse }}</span></span>
        </li>
        {% endif %}
        <li><a href="/nous-rejoindre/">Nous rejoindre</a></li>
      </ul>
    </div>
  </div>
  <div class="fb">
    <span>© {{ site.annee }} {{ site.nom }} — Tous droits réservés</span>
    <span><a href="/mentions-legales/">Mentions légales</a> · <a href="/mentions-legales/#confidentialite">Politique de confidentialité</a></span>
  </div>
</footer>
<script src="/script.js"></script>
</body>
</html>
