<!DOCTYPE html>
<html lang="{{ t.htmlLang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="{{ t.htmlLang }}" href="{{ site.url }}{{ page.url }}">
{% if altUrl %}<link rel="alternate" hreflang="{{ altLang }}" href="{{ site.url }}{{ altUrl }}">{% endif %}
<meta name="robots" content="index, follow, max-image-preview:large">
<meta name="author" content="{{ site.nom }}">
<meta property="og:type" content="{% if layout == 'article.njk' %}article{% else %}website{% endif %}">
<meta property="og:locale" content="{{ t.localeOg }}">
<meta property="og:site_name" content="{{ site.nom }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ image or '/img/communaute-diaspora-paris.jpg' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}{{ image or '/img/communaute-diaspora-paris.jpg' }}">
<meta name="theme-color" content="#8C613B">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css?v={{ build.version }}">

<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"Organization","@id":"{{ site.url }}/#organization",
 "name":{{ site.nom | dump | safe }},"url":"{{ site.url }}/",
 "slogan":{{ site.slogan | dump | safe }},
 "description":"Plateforme communautaire gratuite d'entraide, d'emploi et d'événements pour la diaspora d'Afrique de l'Est en France.",
 "areaServed":{"@type":"Country","name":"France"},
 "email":{{ site.email | dump | safe }},
 "knowsLanguage":["fr","en","sw","rn","rw"],
 "contactPoint":[
  {"@type":"ContactPoint","contactType":"customer support","email":{{ site.email | dump | safe }},"availableLanguage":["French","English","Swahili"]}]
}
</script>
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"WebSite","@id":"{{ site.url }}/#website",
 "name":{{ site.nom | dump | safe }},"url":"{{ site.url }}/","inLanguage":"{{ t.htmlLang }}-{{ t.htmlLang | upper }}",
 "publisher":{"@id":"{{ site.url }}/#organization"}
}
</script>
{% if faqItems %}
  {% set faqData = faqItems %}
{% elif faqKey and lang == 'en' and faqEn and faqEn[faqKey] %}
  {% set faqData = faqEn[faqKey] %}
{% elif faqKey and faq[faqKey] %}
  {% set faqData = faq[faqKey] %}
{% endif %}
{% if faqData %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in faqData %}{"@type":"Question","name":{{ f.question | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.reponse | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}
{% if fil %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{% for e in fil %}{"@type":"ListItem","position":{{ loop.index }},"name":{{ e.nom | dump | safe }},"item":"{{ site.url }}{{ e.url }}"}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{% endif %}
{% if schemaArticle %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"Article",
 "headline":{{ title | dump | safe }},
 "description":{{ description | dump | safe }},
 "image":"{{ site.url }}{{ image }}",
 "inLanguage":"{{ t.htmlLang }}-{{ t.htmlLang | upper }}",
 "datePublished":"{{ page.date | dateIso }}",
 "dateModified":"{{ page.date | dateIso }}",
 "author":{"@id":"{{ site.url }}/#organization"},
 "publisher":{"@id":"{{ site.url }}/#organization"},
 "mainEntityOfPage":{"@type":"WebPage","@id":"{{ site.url }}{{ page.url }}"},
 "articleSection":{{ categorie | dump | safe }}
}
</script>
{% endif %}
{% if schemaOffres %}
{% for o in (offresEn if lang == 'en' else offres) %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"JobPosting",
 "title":{{ o.titre | dump | safe }},
 "description":{{ o.desc | dump | safe }},
 "datePosted":"{{ o.datePosted or '2026-09-01' }}",
 "employmentType":{{ o.typeContrat | dump | safe if o.typeContrat else '"OTHER"' | safe }},
 "hiringOrganization":{"@type":"Organization","name":{{ o.entreprise | dump | safe }}},
 "jobLocation":{"@type":"Place","address":{"@type":"PostalAddress","addressLocality":{{ o.ville | dump | safe }},"addressCountry":"FR"}},
 "directApply":false,
 "identifier":{"@type":"PropertyValue","name":{{ site.nom | dump | safe }},"value":{{ o.id | dump | safe }}}
}
</script>
{% endfor %}
{% endif %}
{% if schemaEvents %}
{% for e in (evenementsEn if lang == 'en' else evenements) %}
<script type="application/ld+json">
{
 "@context":"https://schema.org","@type":"Event",
 "name":{{ e.nom | dump | safe }},
 "description":{{ e.desc | dump | safe }},
 "startDate":"{{ e.dateIso or '2027-02-14' }}",
 "eventAttendanceMode":"https://schema.org/{% if 'ligne' in e.lieu or 'nline' in e.lieu %}Online{% else %}Offline{% endif %}EventAttendanceMode",
 "eventStatus":"https://schema.org/EventScheduled",
 "location":{% if 'ligne' in e.lieu or 'nline' in e.lieu %}{"@type":"VirtualLocation","url":"{{ site.url }}{{ page.url }}"}{% else %}{"@type":"Place","name":{{ e.lieu | dump | safe }},"address":{"@type":"PostalAddress","addressCountry":"FR"}}{% endif %},
 "organizer":{"@id":"{{ site.url }}/#organization"},
 "isAccessibleForFree":true
}
</script>
{% endfor %}
{% endif %}
</head>
<body>

<a href="#contenu" class="skip">{{ t.nav.skip }}</a>
<nav id="nav" aria-label="{{ t.nav.home }}">
  <a href="{{ '/en/' if lang == 'en' else '/' }}" class="logo">Imizi<em>Links</em></a>
  <div class="nav-menu" id="navMenu">
    <div class="nav-item"><a href="{{ '/en/' if lang == 'en' else '/' }}" class="nav-link{% if actif == 'accueil' %} active{% endif %}">{{ t.nav.home }}</a></div>
    <div class="nav-item" id="ddItem">
      <button class="nav-link{% if actif == 'actions' %} active{% endif %}" id="ddBtn" aria-haspopup="true" aria-expanded="false">{{ t.nav.actions }} <span class="caret"></span></button>
      <div class="dropdown">
        <a href="{{ '/en/support/' if lang == 'en' else '/entraide/' }}" class="dd-link"><span class="dd-ico">🤝</span><span><span class="dd-t">{{ t.nav.ddEntraide }}</span><span class="dd-d">{{ t.nav.ddEntraideDesc }}</span></span></a>
        <a href="{{ '/en/opportunities/' if lang == 'en' else '/opportunites/' }}" class="dd-link"><span class="dd-ico">💼</span><span><span class="dd-t">{{ t.nav.ddOpportunites }}</span><span class="dd-d">{{ t.nav.ddOpportunitesDesc }}</span></span></a>
        <a href="{{ '/en/events/' if lang == 'en' else '/evenements/' }}" class="dd-link"><span class="dd-ico">🗓️</span><span><span class="dd-t">{{ t.nav.ddEvenements }}</span><span class="dd-d">{{ t.nav.ddEvenementsDesc }}</span></span></a>
      </div>
    </div>
    <div class="nav-item"><a href="{{ '/en/blog/' if lang == 'en' else '/blog/' }}" class="nav-link{% if actif == 'blog' %} active{% endif %}">{{ t.nav.blog }}</a></div>
    <a href="{{ altUrl }}" class="lang-switch" aria-label="{{ t.switchToOther }}" hreflang="{{ altLang }}">
      <span class="lang-cur">{{ t.otherLangCode }}</span>
    </a>
    <a href="{{ '/en/join-us/' if lang == 'en' else '/nous-rejoindre/' }}" class="nav-cta">{{ t.nav.join }}</a>
  </div>
  <button class="burger" id="burger" aria-label="{{ t.nav.openMenu }}"><span></span><span></span><span></span></button>
</nav>

<main id="contenu">
{{ content | safe }}
</main>

<footer>
  <div class="ft">
    <div>
      <div class="f-logo">Imizi<em>Links</em></div>
      <p class="f-desc">{{ t.footerDesc }}</p>
      <div class="f-socials">
        <a href="{{ site.linkedin or '#linkedin-a-completer' }}" class="soc" aria-label="LinkedIn" rel="noopener" target="_blank">
          <img src="/img/icon-linkedin.svg" alt="LinkedIn" width="18" height="18">
        </a>
        <a href="{{ site.instagram or '#instagram-a-completer' }}" class="soc" aria-label="Instagram" rel="noopener" target="_blank">
          <img src="/img/icon-instagram.svg" alt="Instagram" width="18" height="18">
        </a>
      </div>
    </div>
    <div class="fc"><h2>{{ t.footer.actionsTitle }}</h2><ul>
      <li><a href="{{ '/en/support/' if lang == 'en' else '/entraide/' }}">{{ t.footer.fEntraide }}</a></li>
      <li><a href="{{ '/en/opportunities/' if lang == 'en' else '/opportunites/' }}">{{ t.footer.fOffres }}</a></li>
      <li><a href="{{ '/en/events/' if lang == 'en' else '/evenements/' }}">{{ t.footer.fEvenements }}</a></li>
    </ul></div>
    <div class="fc"><h2>{{ t.footer.guidesTitle }}</h2><ul>
      {% set arts = collections.articlesEn if lang == 'en' else collections.articles %}
      {% for a in arts | reverse %}{% if loop.index <= 3 %}
      <li><a href="{{ a.url }}">{{ a.data.title }}</a></li>{% endif %}{% endfor %}
      <li><a href="{{ '/en/blog/' if lang == 'en' else '/blog/' }}">{{ t.footer.allGuides }}</a></li>
    </ul></div>
    <div class="fc"><h2>{{ t.footer.contactTitle }}</h2>
      <ul class="f-coord">
        <li class="f-coord-l">
          <span class="f-ico" aria-hidden="true"><svg class="ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg></span>
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        </li>
        {% if site.telephone %}
        <li class="f-coord-l">
          <span class="f-ico" aria-hidden="true"><svg class="ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.35 1.9.66 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.31 1.85.53 2.81.66A2 2 0 0 1 22 16.92Z"/></svg></span>
          <a href="tel:{{ site.telephone | replace(r/\s/g, '') }}">{{ site.telephone }}</a>
        </li>
        {% endif %}
        {% if site.adresse %}
        <li class="f-coord-l">
          <span class="f-ico" aria-hidden="true"><svg class="ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></span>
          <span class="f-coord-val">{{ site.adresse }}</span>
        </li>
        {% endif %}
        <li><a href="{{ '/en/join-us/' if lang == 'en' else '/nous-rejoindre/' }}">{{ t.footer.join }}</a></li>
      </ul>
    </div>
  </div>
  <div class="fb">
    <span>© {{ site.annee }} {{ site.nom }} — {{ t.footer.rights }}</span>
    <span><a href="{{ '/en/legal-notice/' if lang == 'en' else '/mentions-legales/' }}">{{ t.footer.legal }}</a> · <a href="{{ '/en/legal-notice/#privacy' if lang == 'en' else '/mentions-legales/#confidentialite' }}">{{ t.footer.privacy }}</a></span>
  </div>
</footer>
<script src="/script.js?v={{ build.version }}"></script>
</body>
</html>
