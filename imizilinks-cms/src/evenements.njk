---
layout: base.njk
permalink: /evenements/
actif: actions
faqKey: evenements
schemaEvents: true
title: "Événements de la diaspora africaine en France — ImiziLinks"
description: "Forums métiers, webinaires sur les démarches administratives, ateliers CV et soirées communautaires. Participation libre et gratuite."
image: /img/communaute-diaspora-paris.jpg
fil:
  - nom: Accueil
    url: /
  - nom: Événements
    url: /evenements/
---
{% from "macros.njk" import phero, faqBloc, cta %}
{{ phero("Nos actions · Événements", "Événements de la communauté",
   "Forums métiers, webinaires sur les démarches administratives, ateliers CV et soirées communautaires. Participation libre et gratuite.",
   "/img/communaute-diaspora-paris.jpg", "Membres de la communauté ImiziLinks réunis à Paris") }}

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Agenda</p>
        <h2>Les prochaines<br><span class="grad">dates à retenir.</span></h2>
        <p>Les rendez-vous en présentiel ont un nombre de places limité. Clique sur « S'inscrire » pour réserver la tienne.</p>
      </div>
      {% if evenements.length %}
      <div class="ev-list reveal">
        {% for e in evenements %}
        <article class="ev-row">
          <div><p class="ev-day">{{ e.jour }}</p><p class="ev-month">{{ e.mois }}</p></div>
          <div>
            <h3 class="ev-name">{{ e.nom }}</h3>
            <p class="ev-loc">{{ e.lieu }}</p>
            {% if e.desc %}<p class="ev-desc">{{ e.desc }}</p>{% endif %}
          </div>
          <div class="ev-side">
            <span class="ev-pill">{{ e.cat }}</span>
            <a href="/evenements/?ev={{ e.label | urlencode }}#form" class="btn btn-outline btn-sm">S'inscrire</a>
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <p class="vide reveal">Aucun événement n'est programmé pour le moment. Écris-nous pour être prévenu·e des prochaines dates.</p>
      {% endif %}
    </div>
  </section>

  <section class="sec light">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Inscription</p>
        <h2>Réserve ta place<br><span class="grad">pour un rendez-vous.</span></h2>
        <p>Choisis l'événement, laisse-nous tes coordonnées et nous te confirmons ta place par retour de message.</p>
      </div>
      <div class="form-solo reveal" id="form">
        <form class="form-card" id="formEvenement" name="evenement" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action="/merci/">
          <input type="hidden" name="form-name" value="evenement">
          <p class="hp-field" hidden><label>Ne rien remplir <input name="bot-field"></label></p>

          <div class="fg"><label for="v-event">Événement concerné</label>
            <select id="v-event" name="evenement_choisi" required>
              <option value="">Choisir un événement</option>
              {% for e in evenements %}<option>{{ e.label }}</option>{% endfor %}
            </select>
          </div>

          <div class="fg-row">
            <div class="fg"><label for="v-prenom">Prénom</label><input id="v-prenom" name="prenom" type="text" placeholder="Marie" required></div>
            <div class="fg"><label for="v-nom">Nom</label><input id="v-nom" name="nom" type="text" placeholder="Niyonzima" required></div>
          </div>
          <div class="fg-row">
            <div class="fg"><label for="v-mail">Email</label><input id="v-mail" name="email" type="email" placeholder="marie@email.com" required></div>
            <div class="fg"><label for="v-tel">Téléphone</label><input id="v-tel" name="telephone" type="tel" placeholder="06 12 34 56 78" required></div>
          </div>
          <div class="fg"><label for="v-nb">Nombre de personnes</label>
            <select id="v-nb" name="nombre_personnes" required>
              <option value="1">1 (moi seul·e)</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5+">5 ou plus</option>
            </select>
          </div>
          <div class="fg"><label for="v-msg">Message <span class="opt">(facultatif)</span></label><textarea id="v-msg" name="message" placeholder="Une question ou une précision ?"></textarea></div>

          <button type="submit" class="btn btn-primary btn-full">M'inscrire</button>
          <p class="form-note">Pour un événement à places limitées, préviens-nous si tu ne peux plus venir : cela libère ta place.</p>
        </form>
      </div>
    </div>
  </section>

{{ faqBloc("Les événements ImiziLinks<br><span class='grad'>en questions.</span>", "Inscription, tarifs, villes et organisation d'un rendez-vous dans ta ville.", faq.evenements) }}
{{ cta("Tu veux organiser un rendez-vous dans ta ville ?", "Une soirée, un atelier, une rencontre : dis-nous ce que tu as en tête et nous t'aidons à le monter.", "Nous écrire", "/nous-rejoindre/#form") }}
