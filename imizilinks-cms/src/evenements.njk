{% from "macros.njk" import phero, faqBloc, cta %}
{{ phero("Nos actions · Événements", "Événements de la communauté",
   "Forums métiers, webinaires d’information sur les démarches d’installation, ateliers CV et soirées communautaires. Participation libre et gratuite.",
   "/img/communaute-diaspora-paris.jpg", "Membres de la communauté Imizi Links réunis à Paris") }}

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Agenda</p>
        <h2>Les prochaines<br><span class="grad">dates à retenir.</span></h2>
        <p>Les rendez-vous en présentiel ont un nombre de places limité. Cliquez sur « S’inscrire » pour réserver la vôtre.</p>
      </div>
      {#
        Gabarit de carte d’événement conservé : les événements sont gérés dans /admin/
        (Événements → src/_data/evenements.json). Dès qu’un événement y est ajouté,
        la liste ci-dessous réapparaît automatiquement à la place du bloc « Pas d’événement ».
      #}
      {% if evenements.length %}
      <div class="ev-list reveal">
        {% for e in evenements %}
        <article class="ev-row">
          <div><p class="ev-day">{{ e.jour }}</p><p class="ev-month">{{ e.mois }}</p></div>
          <div>
            <h3 class="ev-name">{{ e.nom }}</h3>
            <p class="ev-loc">{{ e.lieu }}</p>
            {% if e.desc %}<p class="ev-desc">{{ e.desc }}</p>{% endif %}
          </div>
          <div class="ev-side">
            <span class="ev-pill">{{ e.cat }}</span>
            <a href="/evenements/?ev={{ e.label | urlencode }}#form" class="btn btn-outline btn-sm">S’inscrire</a>
          </div>
        </article>
        {% endfor %}
      </div>
      {% else %}
      <div class="vide reveal">
        <h3 class="vide-t">Pas d’événement pour le moment</h3>
        <p>Nos prochains rendez-vous, forums métiers, ateliers CV, webinaires d’information et rencontres, seront annoncés ici prochainement.</p>
      </div>
      {% endif %}
    </div>
  </section>

  <section class="sec light">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="slabel">Inscription</p>
        <h2>Réservez votre place<br><span class="grad">pour un rendez-vous.</span></h2>
        <p>Choisissez l’événement, laissez-nous vos coordonnées et nous vous confirmons votre place par retour de message.</p>
      </div>
      <div class="form-solo reveal" id="form">
        <form class="form-card" id="formEvenement" name="evenement" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action="/merci/">
          <input type="hidden" name="form-name" value="evenement">
          <p class="hp-field" hidden><label>Ne rien remplir <input name="bot-field"></label></p>

          <div class="fg"><label for="v-event">Événement concerné <span class="required-star" aria-hidden="true">*</span></label>
            <select id="v-event" name="evenement_choisi" required>
              <option value="">Choisir un événement</option>
              {% for e in evenements %}<option>{{ e.label }}</option>{% endfor %}
            </select>
          </div>

          <div class="fg-row">
            <div class="fg"><label for="v-prenom">Prénom <span class="required-star" aria-hidden="true">*</span></label><input id="v-prenom" name="prenom" type="text" placeholder="Marie" required></div>
            <div class="fg"><label for="v-nom">Nom <span class="required-star" aria-hidden="true">*</span></label><input id="v-nom" name="nom" type="text" placeholder="Niyonzima" required></div>
          </div>
          <div class="fg-row">
            <div class="fg"><label for="v-mail">Email <span class="required-star" aria-hidden="true">*</span></label><input id="v-mail" name="email" type="email" placeholder="marie@email.com" required></div>
            <div class="fg"><label for="v-tel">Téléphone <span class="required-star" aria-hidden="true">*</span></label><input id="v-tel" name="telephone" type="tel" placeholder="06 12 34 56 78" required></div>
          </div>
          <div class="fg"><label for="v-nb">Nombre de personnes <span class="required-star" aria-hidden="true">*</span></label>
            <select id="v-nb" name="nombre_personnes" required>
              <option value="1">1 (moi seul·e)</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="5+">5 ou plus</option>
            </select>
          </div>
          <div class="fg"><label for="v-msg">Message <span class="opt">(facultatif)</span></label><textarea id="v-msg" name="message" placeholder="Une question ou une précision ?"></textarea></div>

          <button type="submit" class="btn btn-primary btn-full">M’inscrire</button>
          <p class="form-note">Pour un événement à places limitées, prévenez-nous si vous ne pouvez plus venir, cela libère votre place.</p>
        </form>
      </div>
    </div>
  </section>

{{ faqBloc("Les événements Imizi Links<br><span class='grad'>en questions.</span>", "Inscription, tarifs, villes et organisation d’un rendez-vous dans votre ville.", faq.evenements) }}
{{ cta("Vous voulez organiser un rendez-vous dans votre ville ?", "Une soirée, un atelier, une rencontre, dites-nous ce que vous avez en tête et nous vous aidons à le monter.", "Nous écrire", "/nous-rejoindre/#form") }}
